{
  "name": "pi-dsh",
  "version": "0.2.0-rc.59",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "postinstall": "node apps/pi-dsh/prepare-pty.mjs",
    "icons:generate": "node apps/pi-dsh/generate-icons.mjs",
    "dev:web": "tsx apps/pi-dsh/dev.ts web",
    "dev:desktop": "tsx apps/pi-dsh/dev.ts desktop",
    "build": "tsx apps/pi-dsh/build.ts",
    "start:web": "node apps/pi-dsh/dist/server.mjs",
    "start:desktop": "electron apps/pi-dsh",
    "pi:install": "node apps/pi-dsh/runtime/install.mjs",
    "runtime:prepare": "node apps/pi-dsh/runtime/prepare-native.mjs",
    "test:runtime": "pnpm runtime:prepare --smoke",
    "typecheck": "tsc -p apps/pi-dsh/tsconfig.host.json && tsc -p apps/pi-dsh/tsconfig.client.json",
    "test": "node --import tsx --test apps/pi-dsh/tests/*.test.ts",
    "test:ui": "vitest run --config apps/pi-dsh/vitest.config.ts",
    "test:compat": "tsx apps/pi-dsh/runtime/compat.ts",
    "lint": "oxlint apps/pi-dsh packages/client/ui-primitives/src packages/client/store/src packages/client/ui-dockkit/src packages/util/brand/src packages/util/code-language/src packages/util/workspace-path/src",
    "test:docs": "node --test scripts/check-pi-docs.test.mjs && node scripts/check-pi-docs.mjs",
    "doc-sync": "pnpm test:docs",
    "package:desktop": "pnpm build && electron-builder --config apps/pi-dsh/electron-builder.config.cjs",
    "package:desktop:mac": "pnpm package:desktop --mac",
    "package:desktop:win": "pnpm package:desktop --win",
    "package:desktop:linux": "pnpm package:desktop --linux",
    "pi": "tsx apps/pi-dsh/runtime/run.ts",
    "docs:record": "node scripts/check-pi-docs.mjs --write",
    "test:names": "node --test scripts/check-product-names.test.mjs && node scripts/check-product-names.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/extract-zip": "^2.0.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "extract-zip": "^2.0.1",
    "jsdom": "29.1.1",
    "oxlint": "1.76.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tar": "^7.5.22",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  },
  "description": "A desktop and local Web workspace for the Pi Coding Agent"
}
